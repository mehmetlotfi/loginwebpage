#!/bin/sh

#
#  loginwebpage - Login Page on web
#  Copyright (C) 2026  Mehmet Lotfi
#
#  This program is free software: you can redistribute it and/or modify
#  it under the terms of the GNU General Public License as published by
#  the Free Software Foundation, either version 3 of the License, or
#  (at your option) any later version.
#
#  This program is distributed in the hope that it will be useful,
#  but WITHOUT ANY WARRANTY; without even the implied warranty of
#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#  GNU General Public License for more details.
#
#  You should have received a copy of the GNU General Public License
#  along with this program.  If not, see <https://www.gnu.org/licenses/>.
#

# configure - checks that this system can build loginwebpage and, only if
# everything is fine, writes the Makefile.
#
# How it works, step by step
#   1. find out which system this is (Linux, FreeBSD, OpenBSD, NetBSD,
#      DragonFly, Termux ...);
#   2. check for a C compiler, make, sed and the C library headers/functions the
#      program uses - each check prints "ok" or "NO";
#   3. all fine -> write ./Makefile (its text lives at the end of THIS file,
#      there is no Makefile.in); something missing -> print the command that
#      installs it with the package manager of this system, write NO Makefile
#      and exit with status 1.
#
# The script is plain POSIX sh, so it runs on Linux, the BSDs and Termux
# without needing bash.  It never changes anything except ./Makefile.
#
# Usage:
#   ./configure [--prefix=DIR] [--mandir=DIR] [CC=compiler] [CFLAGS=flags]
#   CC=clang ./configure
#
# Options:
#   --prefix=DIR   where "make install" puts the program (default /usr/local;
#                  on Termux: Termux's own prefix)
#   --mandir=DIR   where the manual page goes (default PREFIX/share/man, or
#                  PREFIX/man on the BSDs)
#   -h, --help     show this text

NAME=loginwebpage
MAKEFILE_MARK="# Makefile generated by ./configure"

# ---------------------------------------------------------------------------
# 0. command line
# ---------------------------------------------------------------------------
prefix=""
mandir=""
for arg in "$@"; do
    case "$arg" in
        -h|--help)  sed -n '/^# configure - checks/,/^NAME=/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
        --prefix=*) prefix=${arg#--prefix=} ;;
        --mandir=*) mandir=${arg#--mandir=} ;;
        CC=*)       CC=${arg#CC=} ;;
        CFLAGS=*)   CFLAGS=${arg#CFLAGS=} ;;
        LDFLAGS=*)  LDFLAGS=${arg#LDFLAGS=} ;;
        *)          echo "configure: unknown option '$arg' (try --help)" >&2; exit 2 ;;
    esac
done

# We must be run from the directory that holds src/ and include/.
if [ ! -d src ] || [ ! -d include ]; then
    echo "configure: run me from the top directory of the source tree" >&2
    exit 2
fi

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------
missing=""        # words describing what is missing (compiler, make, libc-dev ...)
tmp=""            # scratch directory

cleanup() { [ -n "$tmp" ] && rm -rf "$tmp"; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM HUP

have() { command -v "$1" >/dev/null 2>&1; }

# ok "what" "detail"   /   fail "what" "missing-word"
ok()   { printf '  %-40s %s\n' "$1" "ok${2:+ ($2)}"; }
fail() { printf '  %-40s %s\n' "$1" "NO"; missing="$missing $2"; }

# ---------------------------------------------------------------------------
# 1. which system?
# ---------------------------------------------------------------------------
OS=$(uname -s 2>/dev/null || echo unknown)
TERMUX=0
if [ -n "${TERMUX_VERSION:-}" ]; then
    TERMUX=1
else
    case "${PREFIX:-}" in */com.termux/*) TERMUX=1 ;; esac
fi

if [ "$TERMUX" = 1 ]; then
    SYSTEM="Termux (Android)"
    [ -n "$prefix" ] || prefix=${PREFIX:-/data/data/com.termux/files/usr}
else
    SYSTEM=$OS
    [ -n "$prefix" ] || prefix=/usr/local
fi

if [ -z "$mandir" ]; then
    case "$OS" in
        FreeBSD|OpenBSD|NetBSD|DragonFly) mandir=$prefix/man ;;
        *)                                mandir=$prefix/share/man ;;
    esac
fi

printf 'Checking build requirements for %s on %s...\n\n' "$NAME" "$SYSTEM"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/conf.XXXXXX" 2>/dev/null) || {
    tmp="./.conftest.$$"
    mkdir "$tmp" || { echo "cannot create a temporary directory" >&2; exit 1; }
}

# ---------------------------------------------------------------------------
# 2. the checks
# ---------------------------------------------------------------------------

# --- C compiler: $CC if given, otherwise the first that exists
CC_FOUND=""
for c in "${CC:-}" cc gcc clang tcc; do
    [ -n "$c" ] && have "$c" && { CC_FOUND=$c; break; }
done
if [ -n "$CC_FOUND" ]; then
    ok "C compiler" "$CC_FOUND: $($CC_FOUND --version 2>/dev/null | head -n 1)"
else
    fail "C compiler" compiler
fi

# --- make (GNU make and BSD make both work: the Makefile is written portably)
MAKE_FOUND=""
for m in make gmake bmake; do
    have "$m" && { MAKE_FOUND=$m; break; }
done
if [ -n "$MAKE_FOUND" ]; then ok "make" "$MAKE_FOUND"; else fail "make" make; fi

# --- sed: used by this script to scan the sources for #include lines
if have sed; then ok "sed"; else fail "sed" sed; fi

# --- the C library: only possible when there is a working compiler
CFLAGS_TEST="-std=gnu99 -pthread"
LIBS=""
CC_WORKS=0
if [ -n "$CC_FOUND" ]; then
    # A trivial program first: it tells "no working compiler" from "no headers".
    printf 'int main(void){return 0;}\n' > "$tmp/t0.c"
    if $CC_FOUND $CFLAGS_TEST -o "$tmp/t0" "$tmp/t0.c" >"$tmp/log" 2>&1 && "$tmp/t0"; then
        ok "compiler builds and runs programs"
        CC_WORKS=1
    else
        fail "compiler builds and runs programs" libc-dev
        sed 's/^/      /' "$tmp/log" | head -n 5
    fi
fi

if [ "$CC_WORKS" = 1 ]; then
    # Every header the sources include, one by one, so the message can name it.
    for h in sys/socket.h netinet/in.h arpa/inet.h netdb.h net/if.h ifaddrs.h \
             poll.h pthread.h signal.h fcntl.h unistd.h strings.h termios.h \
             getopt.h sys/ioctl.h sys/stat.h grp.h time.h; do
        printf '#include <sys/types.h>\n#include <sys/socket.h>\n#include <%s>\nint main(void){return 0;}\n' "$h" > "$tmp/h.c"
        if $CC_FOUND $CFLAGS_TEST -o "$tmp/h" "$tmp/h.c" >/dev/null 2>&1; then
            ok "header <$h>"
        else
            fail "header <$h>" libc-dev
        fi
    done

    # One program that calls every library function the project needs.
    cat > "$tmp/f.c" <<'CEOF'
#include <sys/types.h>
#include <sys/stat.h>
#include <sys/socket.h>
#include <sys/ioctl.h>
#include <net/if.h>
#include <ifaddrs.h>
#include <getopt.h>
#include <grp.h>
#include <poll.h>
#include <pthread.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <termios.h>
#include <time.h>
#include <unistd.h>
static void *w(void *a) { return a; }
int main(int argc, char **argv) {
    struct ifaddrs *ifa = NULL; pthread_t t; char *line = NULL; size_t cap = 0;
    struct pollfd p = { 0, 0, 0 }; sigset_t s; struct termios tio; struct timespec ts;
    pthread_mutex_t m = PTHREAD_MUTEX_INITIALIZER; pthread_cond_t c = PTHREAD_COND_INITIALIZER;
    struct option lo[] = { { "x", no_argument, NULL, 'x' }, { NULL, 0, NULL, 0 } };
    char tpl[] = "/tmp/xXXXXXX"; char *rp;
    if (getifaddrs(&ifa) == 0) freeifaddrs(ifa);
    if (pthread_create(&t, NULL, w, NULL) == 0) pthread_join(t, NULL);
    sigemptyset(&s); poll(&p, 0, 0);
    (void)getline(&line, &cap, stdin); free(line);
    (void)getopt_long(argc, argv, "x", lo, NULL);
    (void)tcgetattr(0, &tio); (void)strsignal(2);
    clock_gettime(CLOCK_REALTIME, &ts);
    pthread_mutex_lock(&m); pthread_cond_timedwait(&c, &m, &ts); pthread_mutex_unlock(&m);
    rp = realpath(".", NULL); free(rp);
    (void)fsync(1); (void)setgroups(0, NULL); (void)mkstemp(tpl);
    (void)ioctl(1, TIOCGWINSZ, NULL);
    return argc > 99;
}
CEOF
    if $CC_FOUND $CFLAGS_TEST -o "$tmp/f" "$tmp/f.c" >"$tmp/log" 2>&1; then
        ok "library functions (sockets, threads, ...)" "link ok"
    elif $CC_FOUND $CFLAGS_TEST -o "$tmp/f" "$tmp/f.c" -lrt >"$tmp/log" 2>&1; then
        LIBS="-lrt"          # old glibc: clock_gettime lives in librt
        ok "library functions (sockets, threads, ...)" "needs -lrt"
    else
        fail "library functions (sockets, threads, ...)" libc-dev
        sed 's/^/      /' "$tmp/log" | head -n 8
    fi
fi

# --- optional: less (the --help pager).  Missing is only a warning.
if have less; then
    ok "less (pager for --help, optional)"
    NEED_LESS=0
else
    printf '  %-40s %s\n' "less (pager for --help, optional)" "not found - --help will print without paging"
    NEED_LESS=1
fi

# ---------------------------------------------------------------------------
# 3a. something is missing: say how to install it, write no Makefile
# ---------------------------------------------------------------------------
echo
if [ -n "$missing" ]; then
    # a Makefile left over from an earlier successful run is now misleading
    if [ -f Makefile ] && grep -q "^$MAKEFILE_MARK" Makefile 2>/dev/null; then
        rm -f Makefile
    fi

    if [ "$(id -u 2>/dev/null)" = "0" ] || [ "$TERMUX" = 1 ]; then SU=""     # Termux has no sudo
    elif have sudo; then SU="sudo "
    elif have doas; then SU="doas "
    else SU="su -c "; fi

    want_compiler=0; want_make=0
    for m in $missing; do
        case "$m" in compiler|libc-dev) want_compiler=1 ;; make) want_make=1 ;; esac
    done

    echo "Some requirements are missing, so no Makefile was written."
    echo "Install them with your package manager:"
    echo

    if [ "$TERMUX" = 1 ];   then echo "    pkg install clang make"
    elif [ "$OS" = FreeBSD ] || [ "$OS" = DragonFly ]; then
        [ $want_compiler = 1 ] && echo "    ${SU}pkg install gcc      # clang normally comes with the base system"
        [ $want_make = 1 ]     && echo "    ${SU}pkg install gmake    # BSD make is part of the base system, too"
    elif [ "$OS" = OpenBSD ]; then
        [ $want_compiler = 1 ] && echo "    ${SU}pkg_add gcc          # clang is in the base system (install set comp*.tgz)"
        [ $want_make = 1 ]     && echo "    ${SU}pkg_add gmake        # BSD make is part of the base system, too"
    elif [ "$OS" = NetBSD ]; then
        [ $want_compiler = 1 ] && echo "    ${SU}pkgin install gcc12  # gcc is normally in the base system (set comp.tgz)"
        [ $want_make = 1 ]     && echo "    ${SU}pkgin install gmake"
    elif have apt-get;      then echo "    ${SU}apt-get update && ${SU}apt-get install build-essential"
    elif have dnf;          then echo "    ${SU}dnf install gcc make sed glibc-devel"
    elif have yum;          then echo "    ${SU}yum install gcc make sed glibc-devel"
    elif have zypper;       then echo "    ${SU}zypper install gcc make sed glibc-devel"
    elif have pacman;       then echo "    ${SU}pacman -S --needed base-devel"
    elif have apk;          then echo "    ${SU}apk add build-base"
    elif have xbps-install; then echo "    ${SU}xbps-install -S base-devel"
    elif have emerge;       then echo "    ${SU}emerge --ask sys-devel/gcc sys-devel/make sys-libs/glibc"
    elif have nix-env;      then echo "    nix-env -iA nixpkgs.gcc nixpkgs.gnumake"
    elif have eopkg;        then echo "    ${SU}eopkg install -c system.devel"
    else
        echo "    install a C compiler (gcc or clang), make, sed and the C library headers"
    fi
    echo
    echo "Then run ./configure again."
    exit 1
fi

# less is optional: just tell how to get it
if [ "$NEED_LESS" = 1 ]; then
    if [ "$TERMUX" = 1 ]; then echo "Optional:  pkg install less"
    elif have apt-get; then echo "Optional:  sudo apt-get install less"
    elif have dnf;     then echo "Optional:  sudo dnf install less"
    elif have pacman;  then echo "Optional:  sudo pacman -S less"
    elif have apk;     then echo "Optional:  apk add less"
    fi
    echo
fi

# ---------------------------------------------------------------------------
# 3b. everything is there: write the Makefile
# ---------------------------------------------------------------------------

# Which headers (from include/) does a file include, directly?
direct_includes() {
    sed -n 's/^[ 	]*#[ 	]*include[ 	]*"\([^"]*\)".*/\1/p' "$1" |
    while read -r h; do
        [ -f "include/$h" ] && echo "include/$h"
    done
}

# All headers a source file depends on: its own includes, theirs, and so on.
# This is what makes "touch include/x.h; make" rebuild exactly the files that use x.h.
all_includes() {
    todo=$(direct_includes "$1")
    seen=""
    while [ -n "$todo" ]; do
        next=""
        for h in $todo; do
            case " $seen " in *" $h "*) continue ;; esac
            seen="$seen $h"
            next="$next $(direct_includes "$h")"
        done
        todo=$next
    done
    for h in $seen; do echo "$h"; done | sort | tr '\n' ' '
}

SOURCES=$(ls src/*.c | sort)
if [ -z "$SOURCES" ]; then echo "configure: no source files in src/" >&2; exit 2; fi

TAB=$(printf '\t')
OUT=Makefile.new.$$

{
    # ---- settings chosen by configure ----
    echo "$MAKEFILE_MARK - do not edit; change configure's text or re-run ./configure"
    echo "#"
    cat <<'LICEOF'
#
#  loginwebpage - Login Page on web
#  Copyright (C) 2026  Mehmet Lotfi
#
#  This program is free software: you can redistribute it and/or modify
#  it under the terms of the GNU General Public License as published by
#  the Free Software Foundation, either version 3 of the License, or
#  (at your option) any later version.
#
#  This program is distributed in the hope that it will be useful,
#  but WITHOUT ANY WARRANTY; without even the implied warranty of
#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#  GNU General Public License for more details.
#
#  You should have received a copy of the GNU General Public License
#  along with this program.  If not, see <https://www.gnu.org/licenses/>.
#
LICEOF
    echo "# Targets:  make   make install   make uninstall   make clean   make distclean"
    echo
    echo "TARGET   = $NAME"
    echo "BUILDDIR = build"
    echo "PREFIX   = $prefix"
    echo "MANDIR   = $mandir"
    echo "CC       = $CC_FOUND"
    echo "CFLAGS   = ${CFLAGS:--O2 -std=gnu99 -Wall -Wextra}"
    echo "CPPFLAGS ="
    echo "LDFLAGS  = ${LDFLAGS:-}"
    echo "LIBS     = $LIBS"
    echo "THREADS  = -pthread"
    echo "INCLUDES = -I include"
    echo
    printf 'OBJS ='
    for f in $SOURCES; do
        printf ' \\\n    build/%s.o' "$(basename "$f" .c)"
    done
    printf '\n\n'
} > "$OUT"

# ---- the fixed part of the Makefile (written exactly as it is, no expansion) ----
cat >> "$OUT" <<'MAKEEOF'
all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) $(THREADS) -o $(TARGET) $(OBJS) $(LIBS)

MAKEEOF

# ---- one rule per source file: "object <- source + every header it uses" ----
{
    for f in $SOURCES; do
        base=$(basename "$f" .c)
        printf 'build/%s.o: %s %s\n' "$base" "$f" "$(all_includes "$f")"
        printf '%s@mkdir -p $(BUILDDIR)\n' "$TAB"
        printf '%s$(CC) $(CFLAGS) $(CPPFLAGS) $(INCLUDES) $(THREADS) -c %s -o build/%s.o\n\n' "$TAB" "$f" "$base"
    done
} >> "$OUT"

# ---- install / uninstall / clean ----
cat >> "$OUT" <<'MAKEEOF'
install: $(TARGET)
	mkdir -p $(DESTDIR)$(PREFIX)/bin $(DESTDIR)$(MANDIR)/man1
	cp $(TARGET) $(DESTDIR)$(PREFIX)/bin/$(TARGET)
	chmod 755 $(DESTDIR)$(PREFIX)/bin/$(TARGET)
	./$(TARGET) --dump-man > $(DESTDIR)$(MANDIR)/man1/loginwebpage.1
	chmod 644 $(DESTDIR)$(MANDIR)/man1/loginwebpage.1

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/$(TARGET) $(DESTDIR)$(MANDIR)/man1/loginwebpage.1

# Removes the directory with all compiler output and the finished program.
clean:
	rm -rf $(BUILDDIR) $(TARGET)

# Also removes this Makefile (run ./configure to get it back).
distclean: clean
	rm -f Makefile

.PHONY: all install uninstall clean distclean
MAKEEOF

mv "$OUT" Makefile

echo "All requirements are satisfied - Makefile written."
echo
echo "Next steps:"
echo "    ${MAKE_FOUND}                    # build ./$NAME"
echo "    ${MAKE_FOUND} install            # optional, installs into $prefix"
echo "    ./$NAME --help        # the manual"
exit 0
