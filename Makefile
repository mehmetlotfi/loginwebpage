install: $(TARGET)
	mkdir -p $(DESTDIR)$(PREFIX)/bin $(DESTDIR)$(MANDIR)/man1
	cp $(TARGET) $(DESTDIR)$(PREFIX)/bin/$(TARGET)
	chmod 755 $(DESTDIR)$(PREFIX)/bin/$(TARGET)
	./$(TARGET) --dump-man > $(DESTDIR)$(MANDIR)/man1/loginwebpage.1
	chmod 644 $(DESTDIR)$(MANDIR)/man1/loginwebpage.1

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/$(TARGET) $(DESTDIR)$(MANDIR)/man1/loginwebpage.1

# Removes the directory with all compiler output and the finished program.
clean:
	rm -rf $(BUILDDIR) $(TARGET)

# Also removes this Makefile (run ./configure to get it back).
distclean: clean
	rm -f Makefile

.PHONY: all install uninstall clean distclean
